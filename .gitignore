.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.pyc

# Operator-local runtime state — the loop writes these when run from
# this repo's checkout. Committed forge-loop.yaml is the project config;
# everything below is per-operator and must stay out of git.
docs/ops/loop-runner.json
docs/ops/loop-runner-events.jsonl
docs/ops/loop-runner-summaries.jsonl
docs/ops/loop-runner.pid
docs/ops/loop-runner.pause
docs/ops/loop-runner.stop
docs/ops/loop-runner.HALT
docs/ops/loop-runner-logs/
docs/ops/all-nighter.log
docs/ops/loop-runner.force-retry.json
docs/ops/worker-sessions.db*
docs/ops/critic-*.log*
# Per-operator overrides + multi-repo dir + worker-planted settings
forge-loop.local.yaml
# .forge is the maintainer's durable control plane — the loop BOOTS from it, so
# it MUST survive a fresh clone. Track all of it: manifestos, frontier cursor,
# curated memory, the event log, and task sagas. Only the volatile SQLite
# sidecar files are ignored — they're write-ahead scratch, regenerated on every
# write, and must never be committed.
.forge/*.db-wal
.forge/*.db-shm
.forge/*.db-journal
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
# forge-loop runtime
loop-runner.pid
loop-runner.pause
loop-runner.stop
loop-runner-logs/
